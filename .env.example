# Copy to .env for local use; never commit actual credentials.
# Organisers need a random value of at least 16 characters. Guests need no code.
ORGANISER_CREDENTIAL=replace-with-different-random-secret
# Docker only. Leave these unset for Netlify dev and all hosted deployments.
# APP_ENV=local
# LOCAL_DATABASE_URL=postgres://wedding:local-only@db:5432/wedding
# Hosted: Netlify supplies database branch credentials automatically.
# Set separate access credentials for production and preview contexts in Netlify.
